{
	"name": "gisofgothic",
	"private": true,
	"version": "0.4.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"release": "node scripts/release.mjs",
		"deploy": "node scripts/deploy-release.mjs",
		"deploy:preview": "node scripts/check-deploy-environment.mjs && npm run build && node scripts/remove-private-files-from-build.mjs && wrangler pages deploy build --project-name gis-of-gothic --branch podglad",
		"deploy:gate": "cd workers/model-gate && wrangler deploy"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@gltf-transform/core": "^4.5.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.57.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"commit-and-tag-version": "^13.3.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.3.0",
		"vite-plugin-static-copy": "^4.1.1",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/alegreya": "^5.3.0",
		"@fontsource/alegreya-sans": "^5.3.0",
		"@fontsource/grenze-gotisch": "^5.3.0",
		"cesium": "^1.146.0",
		"minisearch": "^7.2.0"
	},
	"license": "MIT"
}
