# Token dostępu Cesium ion (wymagany: model świata jest hostowany jako 3D Tiles na ion).
# Token z https://ion.cesium.com/tokens — wystarczy zakres assets:read dla assetów świata.
PUBLIC_CESIUM_ION_TOKEN=

# Klucz szyfrowania podglądów przedmiotów (base64, 32 bajty). Tworzy go scripts/protect-item-models.mjs.
# Musi być ten sam, którym zaszyfrowano modele w R2 (ADR 0012).
PUBLIC_MODEL_KEY=
