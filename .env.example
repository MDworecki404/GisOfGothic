# Klucz szyfrowania podglądów przedmiotów (base64, 32 bajty). Tworzy go scripts/protect-item-models.mjs.
# Musi być ten sam, którym zaszyfrowano modele w R2 (ADR 0012). Trafia do zbudowanej strony.
PUBLIC_MODEL_KEY=

# Token Cesium ion NIE jest potrzebny w .env strony: jest sekretem bramki zasobów (ADR 0013).
# Ustawienie: cd workers/model-gate && npx wrangler secret put CESIUM_ION_SERVER_TOKEN
