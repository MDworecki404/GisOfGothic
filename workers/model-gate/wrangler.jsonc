{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "gis-of-gothic-model-gate",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"preview_urls": false,
	"r2_buckets": [{ "binding": "MODELS", "bucket_name": "gis-of-gothic-models" }],
	"ratelimits": [
		{
			"name": "MODEL_REQUESTS",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "TILE_REQUESTS",
			"namespace_id": "1002",
			"simple": { "limit": 300, "period": 60 }
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://gisofgothic.dworecki.dev,https://gis-of-gothic.pages.dev,http://localhost:5173,http://localhost:5174,http://localhost:4173",
		"ALLOWED_ION_ASSETS": "6033666",
		"ION_REFERER": "https://gisofgothic.dworecki.dev/"
	}
	// Sekret CESIUM_ION_SERVER_TOKEN: npx wrangler secret put CESIUM_ION_SERVER_TOKEN (ADR 0013)
}
