{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "gis-of-gothic-model-gate",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"preview_urls": false,
	"r2_buckets": [{ "binding": "MODELS", "bucket_name": "gis-of-gothic-models" }],
	"ratelimits": [
		{
			"name": "MODEL_REQUESTS",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "TILE_REQUESTS",
			"namespace_id": "1002",
			"simple": { "limit": 300, "period": 60 }
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://gisofgothic.dworecki.dev,https://gis-of-gothic.pages.dev,https://podglad.gis-of-gothic.pages.dev,http://localhost:5173,http://localhost:5174,http://localhost:4173",
		"ALLOWED_ION_ASSETS": "6033666,6044750,6045068,6045072,6045113,6045115,6047295,6047297,6067772,6067768,6067766,6067764,6067758,6067756,6067752,6067750,6067746,6067744,6088791,6088864,6088836,6088838,6088842,6100029,6100031,6100033,6100035,6100039,6100041,6100043,6100045,6100047,6100049,6104039,6104032,6104037,6104068,6104066",
		"ION_REFERER": "https://gisofgothic.dworecki.dev/"
	}
	// Sekret CESIUM_ION_SERVER_TOKEN: npx wrangler secret put CESIUM_ION_SERVER_TOKEN (ADR 0013)
}
